---
/**
 * "Poznej Kaczi" — sekce hned pod Hero, kde končí atmosféra krajiny
 * a začíná ona sama. Bez portrétu web slouží promo účelu jen z půlky.
 *
 * Zatím bez reálných fotek (viz CLAUDE.md) — placeholdery jsou
 * pojmenované rámečky, stejná disciplína jako `.shot` div na
 * současné homepage. Jakmile budou fotky k dispozici:
 *   import portrait from "../../assets/kaczi-portret.jpg";
 *   import akce from "../../assets/kaczi-koncert.jpg";
 * a předá se sem přes `portraitSrc` / `actionSrc` (astro:assets Image
 * uvnitř, stejně jako v Backdrop.astro) — zbytek layoutu se nemění.
 */
import { Image, type ImageMetadata } from "astro:assets";

interface Props {
  bio: string;
  quote?: { quote: string; source: string };
  ctaHref: string;
  ctaLabel: string;
  portraitSrc?: ImageMetadata | string;
  portraitAlt?: string;
  actionSrc?: ImageMetadata | string;
  actionAlt?: string;
}

const {
  bio,
  quote,
  ctaHref,
  ctaLabel,
  portraitSrc,
  portraitAlt = "Portrét Kaczi",
  actionSrc,
  actionAlt = "Kaczi na pódiu",
} = Astro.props;
---

<section class="bg-bg-2 py-24 md:py-32">
  <div class="mx-auto grid max-w-6xl gap-16 px-6 md:px-12 lg:grid-cols-[1fr_1.1fr] lg:items-center lg:gap-10">
    <!-- bento cluster: portrét + akční záběr -->
    <div class="relative mx-auto w-full max-w-md lg:mx-0">
      <div class="filmic aspect-[4/5] w-full overflow-hidden rounded-2xl border border-line-strong bg-bg-3">
        {
          portraitSrc ? (
            typeof portraitSrc === "string" ? (
              <img src={portraitSrc} alt={portraitAlt} class="h-full w-full object-cover" />
            ) : (
              <Image src={portraitSrc} alt={portraitAlt} widths={[480, 720, 960]} sizes="(min-width: 1024px) 480px, 90vw" class="h-full w-full object-cover" />
            )
          ) : (
            <div class="flex h-full w-full flex-col items-center justify-center gap-3 border border-dashed border-line-strong text-ink-3">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
                <rect x="3" y="6" width="18" height="14" rx="2" />
                <circle cx="12" cy="13" r="3.4" />
                <path d="M8 6l1.5-2h5L16 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="font-sans text-xs uppercase tracking-[0.2em]">Portrét Kaczi · 4:5</span>
            </div>
          )
        }
      </div>

      <div class="absolute -bottom-8 -right-6 hidden aspect-[4/3] w-44 overflow-hidden rounded-xl border-4 border-bg-2 shadow-2xl shadow-black/40 sm:block">
        {
          actionSrc ? (
            typeof actionSrc === "string" ? (
              <img src={actionSrc} alt={actionAlt} class="h-full w-full object-cover" />
            ) : (
              <Image src={actionSrc} alt={actionAlt} widths={[320, 480]} sizes="176px" class="h-full w-full object-cover" />
            )
          ) : (
            <div class="filmic flex h-full w-full flex-col items-center justify-center gap-1 border border-dashed border-line-strong bg-bg-3 text-ink-3">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
                <rect x="3" y="6" width="18" height="14" rx="2" />
                <circle cx="12" cy="13" r="3.4" />
              </svg>
              <span class="font-sans text-[9px] uppercase tracking-[0.15em]">Koncert · 4:3</span>
            </div>
          )
        }
      </div>
    </div>

    <!-- text -->
    <div>
      <p class="mb-4 font-sans text-xs uppercase tracking-[0.35em] text-ember">Kaczi naživo</p>
      <h2 class="font-display text-4xl italic leading-[0.95] text-ink md:text-5xl">Hlas, který znáte z pódia</h2>
      <p class="mt-6 max-w-lg font-sans text-lg leading-relaxed text-ink-2">{bio}</p>

      {
        quote && (
          <blockquote class="mt-8 border-l-2 border-ember/60 pl-5 font-sans text-ink-2">
            <p class="italic">„{quote.quote}"</p>
            <cite class="mt-2 block text-sm not-italic text-ink-3">{quote.source}</cite>
          </blockquote>
        )
      }

      <a
        href={ctaHref}
        class="mt-9 inline-flex items-center gap-2 rounded-full border border-line-strong px-7 py-3 font-sans text-sm font-semibold uppercase tracking-wide text-ink transition-all hover:-translate-y-0.5 hover:bg-bg-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ember"
      >
        {ctaLabel}
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</section>
