---
/**
 * Hlavička vnitřních stránek (ne homepage) — směr "příroda".
 * Stejný typografický jazyk jako Hero, jen bez fotky na pozadí.
 */
interface Props {
  kicker: string;
  title: string;
  intro?: string;
}

const { kicker, title, intro } = Astro.props;
---

<header class="border-b border-line bg-bg-2 pb-16 pt-20 md:pt-16">
  <div class="mx-auto max-w-[1440px] px-6 md:px-12">
    <p class="mb-4 font-sans text-xs uppercase tracking-[0.35em] text-ember">{kicker}</p>
    <h1 class="font-display text-5xl italic leading-[0.95] text-ink md:text-6xl">{title}</h1>
    {intro && <p class="mt-6 max-w-xl font-sans text-lg leading-relaxed text-ink-2">{intro}</p>}
  </div>
</header>
