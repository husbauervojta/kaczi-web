---
/**
 * Košík — vysouvací panel, na všech stránkách stejný. Data žijí jen
 * v localStorage prohlížeče (viz skript v LayoutPriroda.astro), žádný
 * server. Objednávka se zatím odesílá e-mailem — Stripe Checkout je
 * další krok podle CLAUDE.md, tohle je mezikrok, co reálně funguje
 * už teď.
 */
import { withBase } from "../../lib/site";
---

<div
  id="cart-backdrop"
  data-cart-backdrop
  class="fixed inset-0 z-40 hidden bg-black/50 backdrop-blur-sm"
></div>

<aside
  id="cart-drawer"
  class="fixed inset-y-0 right-0 z-50 flex w-full max-w-sm translate-x-full flex-col bg-bg-2 shadow-2xl transition-transform duration-300 ease-out"
  aria-label="Košík"
>
  <div class="flex items-center justify-between border-b border-line px-6 py-6">
    <p class="font-display text-2xl italic text-ink">Košík</p>
    <button
      type="button"
      data-cart-close
      aria-label="Zavřít košík"
      class="flex h-9 w-9 items-center justify-center rounded-full border border-line-strong text-ink hover:bg-bg-3"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <div data-cart-empty class="flex flex-1 flex-col items-center justify-center gap-3 px-6 text-center">
    <p class="font-sans text-ink-3">Košík je zatím prázdný.</p>
    <a href={withBase("/koncept-priroda/obchod/")} data-cart-close class="font-sans text-sm uppercase tracking-wide text-ember hover:text-ember-hi">
      Prohlédnout obchod
    </a>
  </div>

  <div data-cart-items hidden class="flex flex-1 flex-col gap-5 overflow-y-auto px-6 py-6"></div>

  <div data-cart-footer hidden class="border-t border-line px-6 py-6">
    <div class="flex items-center justify-between font-sans text-lg text-ink">
      <span>Celkem</span>
      <span data-cart-total>0 Kč</span>
    </div>
    <a
      data-cart-checkout
      href="#"
      class="mt-5 flex items-center justify-center rounded-full bg-ember px-6 py-3.5 font-sans text-sm font-semibold uppercase tracking-wide text-bg transition-colors hover:bg-ember-hi"
    >
      Odeslat objednávku e-mailem
    </a>
    <p class="mt-3 font-sans text-xs text-ink-3">
      Zatím bez platební brány. Otevře se e-mail se shrnutím, potvrdíme spolu doručení a platbu.
    </p>
  </div>
</aside>

<template id="cart-item-template">
  <div class="flex items-start gap-4" data-cart-item>
    <div class="flex-1">
      <p class="font-sans text-sm text-ink" data-field="title"></p>
      <p class="font-sans text-xs text-ink-3" data-field="meta"></p>
      <div class="mt-2 flex items-center gap-3">
        <button type="button" data-cart-qty="-1" class="flex h-6 w-6 items-center justify-center rounded-full border border-line-strong text-ink" aria-label="Ubrat kus">−</button>
        <span class="font-sans text-sm text-ink" data-field="qty"></span>
        <button type="button" data-cart-qty="1" class="flex h-6 w-6 items-center justify-center rounded-full border border-line-strong text-ink" aria-label="Přidat kus">+</button>
      </div>
    </div>
    <div class="text-right">
      <p class="font-sans text-sm text-ink" data-field="linetotal"></p>
      <button type="button" data-cart-remove class="mt-2 font-sans text-xs uppercase tracking-wide text-ink-3 hover:text-ember">Odebrat</button>
    </div>
  </div>
</template>
