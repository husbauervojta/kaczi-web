---
/**
 * Karta produktu v obchodě, směr "příroda". Tlačítko je napojené na
 * košík přes data atributy, logika žije v LayoutPriroda.astro.
 */
interface Props {
  id: string;
  title: string;
  meta: string;
  priceCzk: number;
  placeholderLabel: string;
}

const { id, title, meta, priceCzk, placeholderLabel } = Astro.props;
---

<article class="flex flex-col">
  <div class="filmic mb-4 flex aspect-square items-center justify-center overflow-hidden rounded-xl border border-dashed border-line-strong bg-bg-3 text-ink-3">
    <div class="flex flex-col items-center gap-2">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
        <rect x="3" y="6" width="18" height="14" rx="2" />
        <circle cx="12" cy="13" r="3.4" />
      </svg>
      <span class="font-sans text-xs uppercase tracking-[0.15em]">{placeholderLabel}</span>
    </div>
  </div>

  <h3 class="font-display text-2xl italic text-ink">{title}</h3>
  <p class="mt-1 font-sans text-sm text-ink-3">{meta}</p>
  <p class="mt-2 font-sans text-lg text-ink">{priceCzk.toLocaleString("cs-CZ")} Kč</p>

  <button
    type="button"
    data-add-to-cart
    data-id={id}
    data-title={title}
    data-price={priceCzk}
    data-meta={meta}
    class="mt-4 inline-flex items-center justify-center gap-2 rounded-full border border-line-strong px-6 py-2.5 font-sans text-sm font-semibold uppercase tracking-wide text-ink transition-colors hover:bg-bg-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ember"
  >
    Do košíku
  </button>
</article>
