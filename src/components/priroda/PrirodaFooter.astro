---
/**
 * Sdílená patička pro celý koncept "příroda".
 */
import { Image } from "astro:assets";
import { SITE, withBase } from "../../lib/site";
import logo from "../../assets/kaczi-logo-transparent.png";
---

<footer class="border-t border-line bg-bg-2 py-14">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-10 px-6 md:flex-row md:items-start md:justify-between md:px-12">
    <div>
      <Image src={logo} alt="Kaczi" height={64} width={134} style="height:64px;width:auto;" />
      <p class="mt-4 max-w-xs font-sans text-sm leading-relaxed text-ink-3">{SITE.claim}</p>
    </div>

    <div class="grid grid-cols-2 gap-10 font-sans text-sm sm:grid-cols-3">
      <div>
        <p class="mb-3 text-xs uppercase tracking-[0.2em] text-ink-3">Web</p>
        <ul class="flex flex-col gap-2 text-ink-2">
          <li><a class="hover:text-ink" href={withBase("/koncept-priroda/koncerty/")}>Koncerty</a></li>
          <li><a class="hover:text-ink" href={withBase("/koncept-priroda/hudba/")}>Hudba</a></li>
          <li><a class="hover:text-ink" href={withBase("/koncept-priroda/obchod/")}>Obchod</a></li>
          <li><a class="hover:text-ink" href={withBase("/koncept-priroda/o-kaczi/")}>O Kaczi</a></li>
        </ul>
      </div>
      <div>
        <p class="mb-3 text-xs uppercase tracking-[0.2em] text-ink-3">Pořadatelé</p>
        <ul class="flex flex-col gap-2 text-ink-2">
          <li><a class="hover:text-ink" href={withBase("/koncept-priroda/pro-poradatele/")}>Press kit</a></li>
          <li><a class="hover:text-ink" href={SITE.booking.phoneHref}>{SITE.booking.phone}</a></li>
          <li><a class="hover:text-ink" href={`mailto:${SITE.booking.email}`}>{SITE.booking.email}</a></li>
        </ul>
      </div>
      <div>
        <p class="mb-3 text-xs uppercase tracking-[0.2em] text-ink-3">Kontakt</p>
        <ul class="flex flex-col gap-2 text-ink-2">
          <li><a class="hover:text-ink" href={withBase("/koncept-priroda/kontakt/")}>Napsat</a></li>
          <li><a class="hover:text-ink" href={`mailto:${SITE.shopEmail}`}>{SITE.shopEmail}</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="mx-auto mt-12 max-w-[1440px] px-6 font-sans text-xs text-ink-3 md:px-12">
    <p>Koncept vizuálního směru, ne finální web. Rok 2026.</p>
  </div>
</footer>
