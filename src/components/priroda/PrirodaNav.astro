---
/**
 * Sdílená navigace pro celý koncept "příroda" — stejná na všech
 * podstránkách. Mobilní menu jede čistě na CSS (checkbox trik), jediné
 * JS na stránce je logika košíku (viz LayoutPriroda.astro).
 *
 * `variant="overlay"` sedí přes fotku v Hero (průhledné pozadí,
 * absolutně pozicované) — používá ho jen homepage. Kdekoliv jinde
 * `variant="solid"` (výchozí) je normální lišta s podkladem, co
 * postrčí obsah pod sebe.
 */
import { Image } from "astro:assets";
import logo from "../../assets/kaczi-logo-transparent.png";

interface Props {
  variant?: "overlay" | "solid";
  current?: string;
}

const { variant = "solid", current } = Astro.props;

const links = [
  { href: "/koncept-priroda/koncerty/", label: "Koncerty" },
  { href: "/koncept-priroda/hudba/", label: "Hudba" },
  { href: "/koncept-priroda/obchod/", label: "Obchod" },
  { href: "/koncept-priroda/o-kaczi/", label: "O Kaczi" },
  { href: "/koncept-priroda/pro-poradatele/", label: "Pro pořadatele" },
  { href: "/koncept-priroda/kontakt/", label: "Kontakt" },
];

const wrapClass =
  variant === "overlay"
    ? "absolute inset-x-0 top-0 z-30"
    : "sticky top-0 z-30 border-b border-line bg-bg/90 backdrop-blur-md";
---

<header class={wrapClass}>
  <div class="mx-auto flex max-w-[1440px] items-center justify-between px-6 py-6 md:px-12">
    <a href="/koncept-priroda/" aria-label="Kaczi, domů" class="shrink-0">
      <Image src={logo} alt="Kaczi" height={64} width={134} style="height:64px;width:auto;" />
    </a>

    <nav class="hidden items-center gap-8 font-sans text-sm text-ink-2 md:flex" aria-label="Hlavní navigace">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={current === l.href ? "page" : undefined}
            class:list={[
              "rounded-sm transition-colors hover:text-ink focus-visible:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ember",
              { "text-ink": current === l.href },
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <button
        type="button"
        data-cart-toggle
        aria-label="Otevřít košík"
        class="relative flex h-10 w-10 items-center justify-center rounded-full border border-line-strong text-ink transition-colors hover:bg-bg-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ember"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M3 4h2l1.6 10.4a2 2 0 0 0 2 1.6h8.6a2 2 0 0 0 2-1.6L21 8H6" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="10" cy="20" r="1.4" />
          <circle cx="17" cy="20" r="1.4" />
        </svg>
        <span
          data-cart-badge
          hidden
          class="absolute -right-1 -top-1 flex h-5 w-5 items-center justify-center rounded-full bg-ember font-sans text-[11px] font-semibold text-bg"
        >0</span>
      </button>

      <input type="checkbox" id="nav-toggle" class="peer hidden" />
      <label
        for="nav-toggle"
        class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-line-strong text-ink md:hidden"
        aria-label="Otevřít menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </label>

      <div class="fixed inset-0 z-40 hidden flex-col bg-bg p-8 peer-checked:flex md:hidden">
        <div class="flex items-center justify-between">
          <Image src={logo} alt="Kaczi" height={64} width={134} style="height:64px;width:auto;" />
          <label for="nav-toggle" class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-line-strong text-ink" aria-label="Zavřít menu">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
            </svg>
          </label>
        </div>
        <nav class="mt-16 flex flex-col gap-7" aria-label="Mobilní navigace">
          {
            links.map((l) => (
              <a href={l.href} class="font-display text-3xl italic text-ink">
                {l.label}
              </a>
            ))
          }
        </nav>
      </div>
    </div>
  </div>
</header>
