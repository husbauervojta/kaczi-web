---
import LayoutPriroda from "../../layouts/LayoutPriroda.astro";
import TourDates from "../../components/priroda/TourDates.astro";
import { upcoming, past, czDate } from "../../lib/gigs";

const gigs = await upcoming();
const odehrane = await past();
---

<LayoutPriroda title="Koncerty, Kaczi" description="Nadcházející i odehrané koncerty Kaczi.">
  <TourDates gigs={gigs} heading="Kde hraju" />

  {
    odehrane.length > 0 && (
      <section class="bg-bg-2 py-20 text-ink md:py-28">
        <div class="mx-auto max-w-6xl px-6 md:px-10">
          <p class="mb-2 font-sans text-xs uppercase tracking-[0.3em] text-moss">Reference</p>
          <h2 class="mb-10 font-display text-4xl italic text-ink md:text-5xl">Naposledy hrála</h2>
          <ul class="divide-y divide-line border-y border-line font-sans">
            {odehrane.slice(0, 8).map((g) => (
              <li class="flex flex-wrap items-baseline justify-between gap-2 py-4">
                <span class="text-ink">
                  {g.data.city}, {g.data.venue}
                </span>
                <time datetime={g.data.date} class="text-sm text-ink-3">
                  {czDate(g.data.date)}
                </time>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</LayoutPriroda>
